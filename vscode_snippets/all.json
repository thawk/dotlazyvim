{
  "datew": {
    "prefix": "datew",
    "body": [
      "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_DAY_NAME"
    ],
    "description": "YYYY-MM-DD with weekday"
  },
  "md//": {
    "prefix": "md//",
    "body": [
      "[//]: # ($TM_SELECTED_TEXT$1)",
      "$0"
    ],
    "description": "Markdown comment"
  },
  "book": {
    "prefix": "book",
    "body": [
      "---",
      "title: ${1}",
      "authors: ${2}",
      "comments: |",
      "　　$TM_SELECTED_TEXT${3}",
      "---",
      "${0}"
    ],
    "description": "book header frontmatter"
  }
}
