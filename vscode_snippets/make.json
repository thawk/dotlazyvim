{
    "skel": {
        "prefix": "skel",
        "body": [
            "TARGET = ${1:target}",
            "",
            "# Listing all sources",
            "SOURCES = $(wildcard *.c)",
            "",
            "# depended libraries",
            "LFLAGS = $0",
            "",
            "all: $(TARGET)",
            "",
            ".PHONY : clean distclean cscope run",
            "clean:",
            "\trm -f $(TARGET) $(SOURCES:.c=.o)",
            "",
            "distclean:",
            "\trm -f $(TARGET) $(SOURCES:.c=.o) $(SOURCES:.c=.d)",
            "",
            "run: $(TARGET)",
            "\t@-./$(TARGET)",
            "",
            "# TARGET depends on \".o\"s, where every .cpp metioned in SOURCES are substituted into a .o",
            "$(TARGET): $(SOURCES:.c=.o)",
            "\t$(CC) -g -o $@ $^ $(LFLAGS)",
            "",
            "# Every .d contains the header files which the correspending .c depends on",
            "# In gnu make, as of a sub makefile, this rule will automatic checked on the next include command",
            "%.d: %.c",
            "\t@set -e; rm -f $@; \\",
            "\t$(CC) -MM $< > $@.$$$$; \\",
            "\tsed 's,\\($*\\)\\.o[ :]*,\\1.o $@ : ,g' < $@.$$$$ > $@; \\",
            "\trm -f $@.$$$$",
            "",
            "# Include \".d\"s for each .c",
            "-include $(SOURCES:.c=.d)"
        ],
        "description": "C base Makefile"
    },
    "skel_2": {
        "prefix": "skel",
        "body": [
            "TARGET = ${1:target}",
            "",
            "# Listing all sources",
            "SOURCES = $(wildcard *.cpp)",
            "",
            "CXXFLAGS = -std=c++11",
            "# depended libraries",
            "LFLAGS = $0",
            "",
            "all: $(TARGET)",
            "",
            ".PHONY : clean distclean cscope run",
            "clean:",
            "\trm -f $(TARGET) $(SOURCES:.cpp=.o)",
            "",
            "distclean:",
            "\trm -f $(TARGET) $(SOURCES:.cpp=.o) $(SOURCES:.cpp=.d)",
            "",
            "run: $(TARGET)",
            "\t@-./$(TARGET)",
            "",
            "# TARGET depends on \".o\"s, where every .cpp metioned in SOURCES are substituted into a .o",
            "$(TARGET): $(SOURCES:.cpp=.o)",
            "\t$(CXX) -g -o $@ $^ $(LFLAGS)",
            "",
            "# Every .d contains the header files which the correspending .cpp depends on",
            "# In gnu make, as of a sub makefile, this rule will automatic checked on the next include command",
            "%.d: %.cpp",
            "\t@set -e; rm -f $@; \\",
            "\t$(CC) -MM $(CXXFLAGS) $< > $@.$$$$; \\",
            "\tsed 's,\\($*\\)\\.o[ :]*,\\1.o $@ : ,g' < $@.$$$$ > $@; \\",
            "\trm -f $@.$$$$",
            "",
            "# Include \".d\"s for each .cpp",
            "-include $(SOURCES:.cpp=.d)"
        ],
        "description": "C++ base Makefile"
    },
    "skel_3": {
        "prefix": "skel",
        "body": [
            "# If the first argument is \"run\"...",
            "ifeq (run,$(firstword $(MAKECMDGOALS)))",
            "\t# use the rest as arguments for \"run\"",
            "\tRUN_ARGS := $(wordlist 2,$(words $(MAKECMDGOALS)),$(MAKECMDGOALS))",
            "endif",
            "",
            "all: lint test",
            "",
            "%:",
            "\t@:",
            "",
            ".PHONY: run",
            "run:",
            "\tpython -m log_analyzer $(RUN_ARGS)",
            "",
            ".PHONY: lint",
            "lint:",
            "\tflake8",
            "",
            ".PHONY: test",
            "test:",
            "\tpytest",
            "",
            "#.PHONY: release",
            "#release:",
            "#\tpython setup.py sdist bdist_wheel upload",
            "",
            ".PHONY: clean",
            "clean:",
            "\tfind . -type f -name *.pyc -delete",
            "\tfind . -type d -name __pycache__ -delete"
        ],
        "description": "Python base Makefile"
    },
    "skel_4": {
        "prefix": "skel",
        "body": [
            "# system python interpreter, used to create virtual environment",
            "PY = python3",
            "VENV = venv",
            "BIN = $(VENV)/bin",
            "",
            "# make it work on windows too",
            "ifeq ($(OS), Windows_NT)",
            "\tBIN = $(VENV)/Scripts",
            "\tPY = python",
            "endif",
            "",
            "# If the first argument is \"run\"...",
            "ifeq (run,$(firstword $(MAKECMDGOALS)))",
            "\t# use the rest as arguments for \"run\"",
            "\tRUN_ARGS := $(wordlist 2,$(words $(MAKECMDGOALS)),$(MAKECMDGOALS))",
            "endif",
            "",
            "all: lint test",
            "",
            "%:",
            "\t@:",
            "",
            "$(VENV): requirements.txt requirements-dev.txt",
            "\t$(PY) -m venv $(VENV)",
            "\t$(BIN)/pip install --upgrade -r requirements.txt",
            "\t$(BIN)/pip install --upgrade -r requirements-dev.txt",
            "\t#$(BIN)/pip install -e .",
            "\ttouch $(VENV)",
            "",
            ".PHONY: run",
            "run: $(VENV)",
            "\t$(BIN)/python -m log_analyzer $(RUN_ARGS)",
            "",
            ".PHONY: lint",
            "lint: $(VENV)",
            "\t$(BIN)/flake8 --exclude $(VENV)",
            "",
            ".PHONY: test",
            "test: $(VENV)",
            "\t$(BIN)/pytest",
            "",
            "#.PHONY: release",
            "#release: $(VENV)",
            "#\t$(BIN)/python setup.py sdist bdist_wheel upload",
            "",
            ".PHONY: clean",
            "clean:",
            "\trm -rf $(VENV)",
            "\tfind . -type f -name *.pyc -delete",
            "\tfind . -type d -name __pycache__ -delete"
        ],
        "description": "Python venv based Makefile"
    },
    "skel_5": {
        "prefix": "skel",
        "body": [
            "include $(GOROOT)/src/Make.inc",
            "",
            "TARG=${1:package}",
            "GOFILES=\\",
            "\t$1.go\\",
            "\t$0",
            "",
            "include $(GOROOT)/src/Make.pkg"
        ],
        "description": "Go package Makefile"
    },
    "skel_6": {
        "prefix": "skel",
        "body": [
            "include $(GOROOT)/src/Make.inc",
            "TARG=${1:program}",
            "GOFILES=\\",
            "\t$1.go\\",
            "\t$0",
            "",
            "include $(GOROOT)/src/Make.cmd"
        ],
        "description": "Go program Makefile"
    }
}
